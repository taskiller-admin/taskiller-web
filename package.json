{
  "name": "taskiller-web",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "api:sync": "node scripts/sync-openapi.mjs",
    "api:generate": "openapi-typescript openapi/taskiller.json -o src/lib/api/generated/schema.d.ts",
    "api:update": "npm run api:sync && npm run api:generate",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "api:check": "node scripts/check-openapi.mjs",
    "release:check": "node scripts/release-check.mjs",
    "smoke:prod": "node scripts/smoke-production.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:e2e:django": "playwright test --config playwright.django.config.ts",
    "release:django": "npm run check && npm run build && npm run test:e2e:django"
  },
  "dependencies": {
    "@tanstack/svelte-query": "6.2.1",
    "clsx": "^2.1.1",
    "openapi-fetch": "0.17.0",
    "phosphor-svelte": "3.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "6.3.4",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.3.3",
    "openapi-typescript": "7.13.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "@sveltejs/adapter-node": "5.5.7"
  },
  "engines": {
    "node": ">=22"
  }
}
