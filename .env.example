# No trailing slash.
PUBLIC_TASKILLER_API_URL=https://taskiller-api-ukwf.onrender.com

# Optional for contract tooling. CI can point this directly at backend main's committed OpenAPI.
TASKILLER_OPENAPI_URL=https://raw.githubusercontent.com/kmab5/taskiller-backend/main/openapi/current.json

# Staff console. Enable only on an origin trusted by the Django staff console.
TASKILLER_ADMIN_ENABLED=false
TASKILLER_ADMIN_WRITES=false
