+<script lang="ts">
+  import { updated } from '$app/state';
+  let applying = $state(false);
+
+  async function applyUpdate() {
+    applying = true;
+    const registration = await navigator.serviceWorker?.getRegistration();
+    if (registration?.waiting) {
