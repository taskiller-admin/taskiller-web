+
+function workItem(name: string, position: number) {
+  return {
+    id: crypto.randomUUID(),
+    kind: 'chore',
+    parentId: null,
+    workTypeId: null,
+    name,
+    description: null,
+    status: 'draft',
+    position,
+    priority: null,
